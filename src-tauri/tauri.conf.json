{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiyoriPet",
  "version": "0.1.4",
  "identifier": "com.hiyoripet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "日和桌宠",
        "width": 360,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-device-scale-factor=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "resources/backend/pet-backend.exe": "backend/pet-backend.exe"
    }
  }
}
